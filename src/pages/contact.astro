---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Say Hello | CozyBerry 💌">
  <div class="max-w-lg mx-auto bg-white/95 border border-pink-100 rounded-3xl p-8 shadow-sm">
    <div class="text-center mb-6">
      <span class="text-3xl">📮</span>
      <h1 class="font-display font-black text-2xl text-pastel-dark mt-2">Send a Cute Note</h1>
      <p class="text-pastel-soft text-xs mt-1">Got a question or just want to send good vibes? Drop a message below!</p>
    </div>

    <form class="space-y-4" onsubmit="event.preventDefault(); alert('Note sent with love! 💌');">
      <div>
        <label class="block text-xs font-bold text-pastel-dark mb-1">Your Name ✨</label>
        <input type="text" required placeholder="e.g. Mia" class="w-full bg-pastel-cream border border-pink-200 rounded-2xl px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-pastel-rose/50" />
      </div>
      <div>
        <label class="block text-xs font-bold text-pastel-dark mb-1">Your Email 💌</label>
        <input type="email" required placeholder="mia@example.com" class="w-full bg-pastel-cream border border-pink-200 rounded-2xl px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-pastel-rose/50" />
      </div>
      <div>
        <label class="block text-xs font-bold text-pastel-dark mb-1">Message 🌷</label>
        <textarea rows="4" required placeholder="Write something sweet..." class="w-full bg-pastel-cream border border-pink-200 rounded-2xl px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-pastel-rose/50"></textarea>
      </div>
      <button type="submit" class="w-full bg-pastel-rose text-white font-black text-sm py-3 rounded-full hover:opacity-90 transition shadow-md shadow-pink-200">
        Send Note 🌸
      </button>
    </form>
  </div>
</BaseLayout>
