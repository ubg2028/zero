---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Me | CozyBerry 🌸">
  <div class="max-w-2xl mx-auto bg-white/95 border border-pink-100 rounded-3xl p-8 sm:p-12 shadow-sm text-center">
    <div class="w-24 h-24 mx-auto rounded-full bg-pastel-pink border-4 border-white shadow-md flex items-center justify-center text-4xl mb-4">
      🧸
    </div>
    <h1 class="font-display font-black text-3xl text-pastel-dark mb-2">Hello, I'm Berry! 🍓</h1>
    <p class="text-pastel-rose font-bold text-sm mb-6">Designer, Dreamer & Web Developer</p>
    
    <div class="text-left text-pastel-soft space-y-4 leading-relaxed text-sm sm:text-base border-t border-pink-100 pt-6">
      <p>
        Welcome to my cute sanctuary on the internet! I created this blog using <strong>Astro JS</strong> and <strong>Tailwind CSS</strong> to share my slow lifestyle diaries, recipes, and creative design experiments.
      </p>
      <p>
        My philosophy is simple: clean spaces, soft colors, and enjoying the little things in life — from a warm cup of tea to a well-written line of code.
      </p>
    </div>
  </div>
</BaseLayout>
