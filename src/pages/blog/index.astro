---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="All Posts | Minimal Blog">
  <h1 style="font-size: 2rem; margin-bottom: 2rem;">All Posts</h1>
  
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    {posts.map((post) => (
      <article style="border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
        <span style="font-size: 0.85rem; color: var(--muted);">
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </span>
        <h2 style="margin: 0.4rem 0; font-size: 1.4rem;">
          <a href={`${base}blog/${post.slug}`} style="text-decoration: none; color: var(--text);">
            {post.data.title}
          </a>
        </h2>
        <p style="color: var(--muted); font-size: 0.95rem;">{post.data.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>
