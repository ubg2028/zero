---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="All Diaries & Stories | CozyBerry">
  <div class="text-center py-8">
    <span class="text-3xl">📚</span>
    <h1 class="font-display font-black text-3xl sm:text-4xl text-pastel-dark mt-2 mb-2">All Journal Entries</h1>
    <p class="text-pastel-soft">Browse through all the happy thoughts and recipes.</p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
    {posts.map(post => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
