---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "A cute & cozy personal aesthetic blog" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Outfit:wght@500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-pastel-cream text-pastel-dark font-sans selection:bg-pastel-pink selection:text-pastel-rose min-h-screen flex flex-col relative overflow-x-clip antialiased">
    
    <!-- ✅ Isolated Background Blobs (No horizontal scroll issue on mobile) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute -top-16 -left-16 sm:-top-24 sm:-left-24 w-72 h-72 sm:w-96 sm:h-96 bg-pastel-pink/45 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-20 sm:-right-32 w-72 h-72 sm:w-[28rem] sm:h-[28rem] bg-pastel-lavender/40 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-20 left-10 sm:left-1/4 w-64 h-64 sm:w-80 sm:h-80 bg-pastel-peach/40 rounded-full blur-3xl"></div>
    </div>

    <!-- ✅ Responsive Navbar -->
    <header class="sticky top-2 sm:top-4 z-50 max-w-4xl mx-auto w-full px-3 sm:px-4 mb-4 sm:mb-6">
      <nav class="bg-white/85 backdrop-blur-md border border-pink-100/90 shadow-sm shadow-pink-100/60 rounded-2xl sm:rounded-full px-4 sm:px-6 py-2.5 sm:py-3.5 transition-all">
        <div class="flex justify-between items-center">
          
          <!-- Logo -->
          <a href={base} class="font-display font-black text-lg sm:text-xl text-pastel-dark tracking-tight flex items-center gap-2 group">
            <span class="bg-pastel-pink/80 p-1.5 rounded-full text-xs sm:text-sm group-hover:rotate-12 transition-transform duration-300">🌸</span> 
            <span>CozyBerry<span class="text-pastel-rose">.</span></span>
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center gap-6 font-bold text-sm text-pastel-soft">
            <a href={base} class="hover:text-pastel-rose transition">Home</a>
            <a href={`${base}blog`} class="hover:text-pastel-rose transition">Stories</a>
            <a href={`${base}about`} class="hover:text-pastel-rose transition">About</a>
            <a href={`${base}contact`} class="hover:text-pastel-rose transition">Contact</a>
            <a 
              href={`${base}blog`} 
              class="bg-pastel-pink text-pastel-rose px-4 py-1.5 rounded-full font-extrabold hover:bg-pastel-rose hover:text-white transition shadow-sm hover:shadow active:scale-95"
            >
              Join 💌
            </a>
          </div>

          <!-- Mobile Hamburger Button -->
          <button 
            id="mobile-menu-btn" 
            aria-label="Toggle navigation menu"
            class="md:hidden p-2 rounded-xl text-pastel-dark hover:bg-pastel-pink/30 active:scale-95 transition-all focus:outline-none"
          >
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Mobile Collapsible Menu -->
        <div id="mobile-menu" class="hidden md:hidden pt-3 pb-2 border-t border-pink-100/70 mt-3 flex flex-col gap-2 font-bold text-sm text-pastel-soft">
          <a href={base} class="px-3 py-2 rounded-xl hover:bg-pastel-pink/20 hover:text-pastel-rose transition">Home</a>
          <a href={`${base}blog`} class="px-3 py-2 rounded-xl hover:bg-pastel-pink/20 hover:text-pastel-rose transition">Stories</a>
          <a href={`${base}about`} class="px-3 py-2 rounded-xl hover:bg-pastel-pink/20 hover:text-pastel-rose transition">About</a>
          <a href={`${base}contact`} class="px-3 py-2 rounded-xl hover:bg-pastel-pink/20 hover:text-pastel-rose transition">Contact</a>
          <a 
            href={`${base}blog`} 
            class="text-center mt-1 bg-pastel-pink text-pastel-rose px-4 py-2.5 rounded-xl font-extrabold hover:bg-pastel-rose hover:text-white transition active:scale-98 shadow-sm"
          >
            Join 💌
          </a>
        </div>
      </nav>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-4xl mx-auto w-full px-4 sm:px-6 flex-grow">
      <slot />
    </main>

    <!-- Cute Footer -->
    <footer class="mt-16 sm:mt-20 border-t border-pink-100/80 bg-white/60 backdrop-blur-md py-8 sm:py-10">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <div class="text-xl sm:text-2xl mb-2 tracking-widest animate-pulse">🎀 🍵 🧸</div>
        <p class="font-display font-bold text-pastel-dark text-base sm:text-lg">CozyBerry Minimal Blog</p>
        <p class="text-pastel-soft text-xs sm:text-sm mt-1">Made with lots of matcha, peaceful moments & Astro JS</p>
        <p class="text-[11px] sm:text-xs text-pastel-soft/70 mt-4">© {new Date().getFullYear()} CozyBerry • Stay Lovely ✨</p>
      </div>
    </footer>

    <!-- Client-side Script for Mobile Menu Toggle -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');

      btn?.addEventListener('click', () => {
        const isClosed = menu?.classList.contains('hidden');
        if (isClosed) {
          menu?.classList.remove('hidden');
          openIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        } else {
          menu?.classList.add('hidden');
          openIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
