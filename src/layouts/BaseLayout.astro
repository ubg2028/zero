---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "A cute & cozy personal aesthetic blog" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Outfit:wght@500;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-pastel-cream text-pastel-dark font-sans selection:bg-pastel-pink selection:text-pastel-rose min-h-screen flex flex-col relative overflow-x-hidden">
    
    <!-- Aesthetic Floating Blobs Background -->
    <div class="fixed top-[-10%] left-[-5%] w-96 h-96 bg-pastel-pink/40 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed top-[30%] right-[-10%] w-[28rem] h-[28rem] bg-pastel-lavender/40 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed bottom-[-10%] left-[20%] w-80 h-80 bg-pastel-peach/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- Cute Navbar -->
    <header class="sticky top-4 z-50 max-w-4xl mx-auto w-full px-4 mb-6">
      <nav class="bg-white/80 backdrop-blur-md border border-pink-100 shadow-sm shadow-pink-100/50 rounded-full px-6 py-3.5 flex justify-between items-center">
        <a href={base} class="font-display font-black text-xl text-pastel-dark tracking-tight flex items-center gap-2 hover:scale-105 transition">
          <span class="bg-pastel-pink p-1.5 rounded-full text-sm">🌸</span> CozyBerry.
        </a>
        <div class="flex items-center gap-6 font-bold text-sm text-pastel-soft">
          <a href={base} class="hover:text-pastel-rose transition">Home</a>
          <a href={`${base}blog`} class="hover:text-pastel-rose transition">Stories</a>
          <a href={`${base}about`} class="hover:text-pastel-rose transition">About</a>
          <a href={`${base}contact`} class="hover:text-pastel-rose transition">Contact</a>
          <a href={`${base}blog`} class="bg-pastel-pink text-pastel-rose px-4 py-1.5 rounded-full font-extrabold hover:bg-pastel-rose hover:text-white transition shadow-sm">
            Join 💌
          </a>
        </div>
      </nav>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-4xl mx-auto w-full px-4 flex-grow">
      <slot />
    </main>

    <!-- Cute Footer -->
    <footer class="mt-20 border-t border-pink-100/80 bg-white/50 backdrop-blur-sm py-10">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <div class="text-2xl mb-2">🎀 🍵 🧸</div>
        <p class="font-display font-bold text-pastel-dark text-lg">CozyBerry Minimal Blog</p>
        <p class="text-pastel-soft text-sm mt-1">Made with lots of matcha, peaceful moments & Astro JS</p>
        <p class="text-xs text-pastel-soft/70 mt-4">© {new Date().getFullYear()} CozyBerry • Stay Lovely ✨</p>
      </div>
    </footer>
  </body>
</html>
