---
interface Props {
  post: any;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;

const wordCount = post.body ? post.body.split(/\s+/).length : 200;
const readTime = Math.ceil(wordCount / 180);
---

<article class="bg-white/90 border border-pink-100 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-pink-100/50 hover:-translate-y-1.5 transition-all duration-300 flex flex-col group">
  {post.data.image && (
    <a href={`${base}blog/${post.slug}`} class="block h-48 overflow-hidden relative">
      <img 
        src={post.data.image} 
        alt={post.data.title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
      />
      <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-pastel-dark shadow-sm">
        {post.data.emoji} {post.data.category}
      </span>
    </a>
  )}
  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-center gap-2 text-xs font-bold text-pastel-soft mb-2">
      <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
      <span>•</span>
      <span>{readTime} min read</span>
    </div>

    <h3 class="font-display font-extrabold text-xl leading-snug mb-2 text-pastel-dark group-hover:text-pastel-rose transition">
      <a href={`${base}blog/${post.slug}`}>{post.data.title}</a>
    </h3>

    <p class="text-pastel-soft text-sm line-clamp-2 leading-relaxed mb-4 flex-grow">
      {post.data.description}
    </p>

    <div class="pt-3 border-t border-pink-50 flex items-center justify-between">
      <span class="text-xs font-bold text-pastel-dark flex items-center gap-1.5">
        {post.data.author}
      </span>
      <a href={`${base}blog/${post.slug}`} class="text-xs font-extrabold text-pastel-rose group-hover:translate-x-1 transition flex items-center gap-1">
        Read Story &rarr;
      </a>
    </div>
  </div>
</article>
